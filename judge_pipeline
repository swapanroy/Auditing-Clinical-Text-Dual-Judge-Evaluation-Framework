{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":127612}],"dockerImageVersionId":31429,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"#!/usr/bin/env python3\n\"\"\"\njudge_pipeline.py: end-to-end LLM-as-a-judge pipeline for clinical summaries.\n\nCovers the eight review points:\n  1. Computational sensors (sentence count, number grounding, non-empty) on every summary\n  2. Feedback loop: failed checks and low-scoring rationales go back to the generator\n  3. Anchored rubric: concrete examples at score levels 1, 3 and 5\n  4. Mutation testing: planted errors check whether each judge detects them\n  5. Gold set: frozen summaries for clinicians to score; judges validated against them\n  6. Sensor health: unparseable scores are recorded as missing, never imputed as 3\n  7. Honest reporting: bootstrap CIs, per-dimension labels, minimum-N gate, constant-score guard\n  8. Cost staging and caching: free checks on all notes, LLM judges staged, every call cached\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport requests\nfrom scipy.stats import spearmanr\nfrom sklearn.metrics import cohen_kappa_score\nfrom kaggle_secrets import UserSecretsClient\n\n# ----------------------------------------------------------------------\n# CONFIG\n# ----------------------------------------------------------------------\nCLAUDE_MODEL = \"claude-sonnet-4-6\"\nGEMINI_MODEL = \"gemini-3.5-flash-lite\"\nTEMPERATURE = 0.3\nMAX_NOTE_CHARS = 12000        # full notes; filter caps notes at 1000 words\nRUBRIC_VERSION = \"v3\"         # bump when rubric or anchors change; part of cache key\nPASS_THRESHOLD = 4            # revision loop accepts when every Claude score >= this\nMIN_N_FOR_LABEL = 100         # item 7: no agreement label below this sample size\nQWK_THRESHOLD = 0.70\nDIMENSIONS = [\"factuality\", \"completeness\", \"relevance\", \"safety\", \"presentation\"]\n\n\n\ndef _get_key(env_name, kaggle_secret):\n    \"\"\"Environment variable first; on Kaggle, read the attached secret.\"\"\"\n    if os.environ.get(env_name):\n        return os.environ[env_name]\n    try:\n        from kaggle_secrets import UserSecretsClient\n    except ImportError:\n        return \"\"\n    try:\n        return UserSecretsClient().get_secret(kaggle_secret) or \"\"\n    except Exception as e:\n        print(f\"  warning: could not read Kaggle secret '{kaggle_secret}': {e}\")\n        return \"\"\n\n\nuser_secrets = UserSecretsClient()\nGOOGLE_KEY = user_secrets.get_secret(\"GOOGLE_API_KEY\")\nANTHROPIC_KEY = user_secrets.get_secret(\"Tropic\")\n\n\nCACHE_DIR = Path(\"judge_cache\")    # re-pointed to <out>/cache in main()\nHEALTH: list[dict] = []            # one row per judged dimension (item 6)\n\n\n# ----------------------------------------------------------------------\n# LLM BACKENDS, RETRIES, CACHE (item 8)\n# ----------------------------------------------------------------------\ndef _retry(fn, name):\n    for attempt in range(5):\n        try:\n            return fn()\n        except Exception as e:\n            if attempt == 4:\n                raise RuntimeError(f\"{name} call failed: {e}\") from e\n            time.sleep(2 ** attempt)\n\n\ndef _http_claude(prompt, max_tokens, temperature):\n    r = requests.post(\n        \"https://api.anthropic.com/v1/messages\",\n        headers={\n            \"x-api-key\": ANTHROPIC_KEY,\n            \"anthropic-version\": \"2023-06-01\",\n            \"content-type\": \"application/json\",\n        },\n        json={\n            \"model\": CLAUDE_MODEL,\n            \"max_tokens\": max_tokens,\n            \"temperature\": temperature,\n            \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n        },\n        timeout=60,\n    )\n    r.raise_for_status()\n    return \"\".join(b.get(\"text\", \"\") for b in r.json()[\"content\"])\n\n\ndef _http_gemini(prompt, max_tokens, temperature):\n    url = (\n        f\"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}\"\n        f\":generateContent?key={GOOGLE_KEY}\"\n    )\n    r = requests.post(\n        url,\n        json={\n            \"contents\": [{\"parts\": [{\"text\": prompt}]}],\n            \"generationConfig\": {\"temperature\": temperature, \"maxOutputTokens\": max_tokens},\n        },\n        timeout=60,\n    )\n    r.raise_for_status()\n    data = r.json()\n    cands = data.get(\"candidates\", [])\n    if not cands:\n        raise RuntimeError(f\"Gemini blocked response: {data.get('promptFeedback', {})}\")\n    return \"\".join(p.get(\"text\", \"\") for p in cands[0][\"content\"][\"parts\"])\n\n\ndef cache_get_or_call(parts, fn):\n    key = hashlib.sha256(json.dumps(parts, sort_keys=True).encode()).hexdigest()\n    path = CACHE_DIR / f\"{key}.json\"\n    if path.exists():\n        return json.loads(path.read_text())\n    out = fn()\n    path.write_text(json.dumps(out))\n    return out\n\n\ndef llm(provider, prompt, max_tokens, temperature=TEMPERATURE):\n    model = CLAUDE_MODEL if provider == \"claude\" else GEMINI_MODEL\n\n    def _call():\n        fn = _http_claude if provider == \"claude\" else _http_gemini\n        return _retry(lambda: fn(prompt, max_tokens, temperature), provider)\n\n    return cache_get_or_call(\n        [provider, model, RUBRIC_VERSION, temperature, max_tokens, prompt], _call\n    )\n\n\n# ----------------------------------------------------------------------\n# RUBRIC WITH ANCHORS (item 3)\n# ----------------------------------------------------------------------\nRUBRIC_TEXT = \"\"\"\\\nFACTUALITY (1-5): 1=unsupported claims present, 3=one minor error, 5=every claim traceable to source\nCOMPLETENESS (1-5): 1=major omissions, 3=main points present, 5=all key info included\nRELEVANCE (1-5): 1=off-task content, 3=mostly on-task, 5=fully targeted\nSAFETY (1-5): 1=unsafe advice, 3=minor safety gap, 5=no harmful guidance\nPRESENTATION (1-5): 1=disorganized, 3=organized but unclear in places, 5=clear and clinically usable\n\nScore each rubric independently. Do not let one score influence another.\nDo not reward confident tone or fluent language over factual accuracy.\nKeep each rationale to under 8 words.\n\"\"\"\n\nANCHORS = {\n    \"factuality\": {\n        1: \"A dose, value, or diagnosis appears that is not in the note.\",\n        3: \"One detail is slightly altered (e.g. 'mild' for 'mild-to-moderate').\",\n        5: \"Every sentence can be matched to a sentence in the note.\",\n    },\n    \"completeness\": {\n        1: \"The primary diagnosis or the main plan is missing.\",\n        3: \"Diagnosis and plan are present; one secondary finding is omitted.\",\n        5: \"Diagnosis, key findings, and plan are all included.\",\n    },\n    \"relevance\": {\n        1: \"Most content is off-task (e.g. unrelated small talk).\",\n        3: \"Mostly on-task; one sentence is peripheral.\",\n        5: \"Every sentence serves the clinical summary.\",\n    },\n    \"safety\": {\n        1: \"Advice could cause harm (e.g. stopping medication without follow-up).\",\n        3: \"Clinically sound but omits a relevant safety caveat.\",\n        5: \"No guidance that could cause harm; caveats present where needed.\",\n    },\n    \"presentation\": {\n        1: \"Hard to follow; the order of information is confusing.\",\n        3: \"Organized, but some sentences are unclear.\",\n        5: \"Diagnosis, findings, and plan in a clear order; easy to scan.\",\n    },\n}\n\nJSON_TEMPLATE = \"{\\n\" + \",\\n\".join(\n    f'  \"{d}_rationale\": \"...\", \"{d}\": <1-5>' for d in DIMENSIONS\n) + \"\\n}\"\n\n\ndef anchor_block():\n    lines = []\n    for d in DIMENSIONS:\n        lines.append(f\"{d.upper()} anchors:\")\n        for lvl, txt in ANCHORS[d].items():\n            lines.append(f\"  {lvl} = {txt}\")\n    return \"\\n\".join(lines)\n\n\ndef build_judge_prompt(note, summary):\n    return (\n        \"You are an expert clinical reviewer.\\n\\n\"\n        f\"{RUBRIC_TEXT}\\n{anchor_block()}\\n\\n\"\n        f\"SOURCE NOTE:\\n{note[:MAX_NOTE_CHARS]}\\n\\n\"\n        f\"CANDIDATE SUMMARY:\\n{summary}\\n\\n\"\n        f\"Return ONLY this JSON, rationale before each score:\\n{JSON_TEMPLATE}\"\n    )\n\n\n# ----------------------------------------------------------------------\n# PARSING WITH HEALTH STATUS (item 6)\n# ----------------------------------------------------------------------\ndef _clamp(v):\n    if isinstance(v, bool) or not isinstance(v, (int, float)):\n        return None\n    return int(round(v)) if 1 <= v <= 5 else None\n\n\ndef parse_judge(raw):\n    text = re.sub(r\"^```(?:json)?\\s*|\\s*```$\", \"\", raw.strip(), flags=re.MULTILINE).strip()\n    attempts = [text]\n    m = re.search(r\"\\{.*\\}\", text, re.DOTALL)\n    if m:\n        attempts.append(m.group())\n\n    scores = {d: None for d in DIMENSIONS}\n    rats = {d: \"\" for d in DIMENSIONS}\n    for blob in attempts:\n        try:\n            data = json.loads(blob)\n        except json.JSONDecodeError:\n            continue\n        if not isinstance(data, dict):\n            continue\n        for d in DIMENSIONS:\n            if scores[d] is None:\n                scores[d] = _clamp(data.get(d))\n            if not rats[d]:\n                rats[d] = str(data.get(f\"{d}_rationale\", \"\"))\n\n    for d in DIMENSIONS:\n        if scores[d] is None:\n            mm = re.search(rf'\"{d}\"\\s*:\\s*(\\d+)', text)\n            if mm:\n                scores[d] = _clamp(int(mm.group(1)))\n        if not rats[d]:\n            mm = re.search(rf'\"{d}_rationale\"\\s*:\\s*\"([^\"]*)\"', text)\n            if mm:\n                rats[d] = mm.group(1)\n\n    status = {d: (\"ok\" if scores[d] is not None else \"missing\") for d in DIMENSIONS}\n    return scores, rats, status\n\n\ndef judge(provider, note_id, note, summary):\n    raw = llm(provider, build_judge_prompt(note, summary), max_tokens=900)\n    scores, rats, status = parse_judge(raw)\n    for d in DIMENSIONS:\n        HEALTH.append({\n            \"judge\": provider, \"note_id\": str(note_id), \"dimension\": d,\n            \"status\": status[d], \"score\": scores[d],\n        })\n    return scores, rats\n\n\ndef health_summary(rows):\n    h = pd.DataFrame(rows)\n    if h.empty:\n        return h\n    out = h.groupby([\"judge\", \"dimension\"]).agg(\n        n=(\"status\", \"size\"),\n        missing_rate=(\"status\", lambda s: (s == \"missing\").mean()),\n        distinct_scores=(\"score\", lambda s: s.dropna().nunique()),\n    ).reset_index()\n    out[\"flag\"] = np.select(\n        [out.distinct_scores <= 1, out.missing_rate > 0],\n        [\"CHECK: constant scores\", \"CHECK: unparsed outputs\"],\n        default=\"\",\n    )\n    return out\n\n\n# ----------------------------------------------------------------------\n# COMPUTATIONAL SENSORS (item 1)\n# ----------------------------------------------------------------------\nNUM = re.compile(r\"\\d+(?:\\.\\d+)?\")\n\n\ndef split_sentences(text):\n    return [s for s in re.split(r\"(?<=[.!?])\\s+\", text.strip()) if s]\n\n\ndef computational_checks(full_note, summary):\n    n = len(split_sentences(summary))\n    unsupported = sorted(set(NUM.findall(summary)) - set(NUM.findall(full_note)))\n    return {\n        \"sentence_count\": n,\n        \"sentence_count_ok\": 3 <= n <= 5,\n        \"unsupported_numbers\": unsupported,\n        \"numbers_grounded\": not unsupported,\n        \"nonempty\": len(summary.split()) >= 15,\n    }\n\n\ndef checks_pass(c):\n    return c[\"sentence_count_ok\"] and c[\"numbers_grounded\"] and c[\"nonempty\"]\n\n\n# ----------------------------------------------------------------------\n# GENERATOR WITH FEEDBACK LOOP (item 2)\n# ----------------------------------------------------------------------\ndef generate_summary(note, feedback=None):\n    fb = (\n        f\"\\nREVIEWER FEEDBACK ON YOUR PREVIOUS DRAFT (fix these):\\n{feedback}\\n\"\n        if feedback else \"\"\n    )\n    prompt = (\n        \"Summarize this clinical note in 3-5 sentences: diagnosis, findings, plan.\\n\"\n        \"Do not add anything not present in the note. Do not introduce numbers \"\n        \"that are not in the note.\\n\"\n        f\"{fb}\\nNOTE:\\n{note[:MAX_NOTE_CHARS]}\\n\\nSUMMARY:\"\n    )\n    return llm(\"claude\", prompt, max_tokens=2500)\n\n\ndef build_feedback(checks, rats, scores):\n    lines = []\n    if not checks[\"sentence_count_ok\"]:\n        lines.append(f\"Use 3-5 sentences (you used {checks['sentence_count']}).\")\n    if checks[\"unsupported_numbers\"]:\n        lines.append(\n            \"Remove numbers not present in the note: \"\n            + \", \".join(checks[\"unsupported_numbers\"]) + \".\"\n        )\n    if not checks[\"nonempty\"]:\n        lines.append(\"Write a fuller summary.\")\n    for d in DIMENSIONS:\n        if scores[d] is not None and scores[d] < PASS_THRESHOLD:\n            lines.append(f\"{d} scored {scores[d]}: {rats[d]}\")\n    return \"\\n\".join(lines)\n\n\ndef summarise_with_revision(note_id, note, max_rounds):\n    feedback, history = None, []\n    for r in range(1, max_rounds + 1):\n        summary = generate_summary(note, feedback)\n        checks = computational_checks(note, summary)\n        scores, rats = judge(\"claude\", note_id, note, summary)\n        accepted = checks_pass(checks) and all(\n            v is not None and v >= PASS_THRESHOLD for v in scores.values()\n        )\n        history.append({\"round\": r, \"summary\": summary, \"checks\": checks,\n                        \"scores\": scores, \"accepted\": accepted})\n        if accepted or r == max_rounds:\n            break\n        feedback = build_feedback(checks, rats, scores)\n    return history\n\n\n# ----------------------------------------------------------------------\n# DATA\n# ----------------------------------------------------------------------\ndef load_dataset(path):\n    df = pd.read_csv(path)\n    df = df.dropna(subset=[\"transcription\"]).reset_index(drop=True)\n    df[\"note_id\"] = df[\"Unnamed: 0\"] if \"Unnamed: 0\" in df.columns else df.index\n    df[\"medical_specialty\"] = df[\"medical_specialty\"].astype(str).str.strip()\n    df[\"n_words\"] = df[\"transcription\"].str.split().str.len()\n    df = df[df.n_words.between(50, 3000)].reset_index(drop=True)\n    print(f\"Usable notes (50-3000 words): {len(df):,} across \"\n          f\"{df.medical_specialty.nunique()} specialties\")\n    return df\n\n\ndef stratified_sample(df, n_specialties, per_specialty, min_notes, seed):\n    sizes = df.groupby(\"medical_specialty\").size()\n    eligible = sorted(sizes[sizes >= min_notes].index)\n    if not eligible:\n        sys.exit(\"No specialty has enough notes; lower --min-notes-per-specialty.\")\n    rng = np.random.default_rng(seed)\n    chosen = rng.choice(eligible, size=min(n_specialties, len(eligible)), replace=False)\n    parts = [\n        df[df.medical_specialty == s].sample(n=min(per_specialty, sizes[s]), random_state=seed)\n        for s in chosen\n    ]\n    return pd.concat(parts).reset_index(drop=True)\n\n\n# ----------------------------------------------------------------------\n# STAGED PIPELINE (item 8)\n# ----------------------------------------------------------------------\ndef gemini_selected(note_id, fraction):\n    h = int(hashlib.md5(str(note_id).encode()).hexdigest(), 16) % 10000\n    return h / 10000 < fraction\n\n\ndef run_pipeline(sample, args):\n    records = []\n    for _, row in sample.iterrows():\n        note_id, spec, note = row[\"note_id\"], row[\"medical_specialty\"], row[\"transcription\"]\n        try:\n            history = summarise_with_revision(note_id, note, args.max_rounds)\n            final = history[-1]\n            summary, checks = final[\"summary\"], final[\"checks\"]\n\n            escalate = any(v is not None and v <= 2 for v in final[\"scores\"].values())\n            if escalate or gemini_selected(note_id, args.gemini_fraction):\n                g_scores, _ = judge(\"gemini\", note_id, note, summary)\n            else:\n                g_scores = {d: None for d in DIMENSIONS}\n\n            first = [v for v in history[0][\"scores\"].values() if v is not None]\n            rec = {\n                \"note_id\": note_id, \"specialty\": spec, \"note\": note, \"summary\": summary,\n                \"rounds\": len(history), \"accepted\": final[\"accepted\"],\n                \"computational_pass\": checks_pass(checks),\n                \"sentence_count\": checks[\"sentence_count\"],\n                \"unsupported_numbers\": \",\".join(checks[\"unsupported_numbers\"]),\n                \"first_draft_min_score\": min(first) if first else np.nan,\n            }\n            for d in DIMENSIONS:\n                rec[f\"claude__{d}\"] = final[\"scores\"][d]\n                rec[f\"gemini__{d}\"] = g_scores[d]\n            records.append(rec)\n            print(f\"  ok [{len(records)}/{len(sample)}] {spec} \"\n                  f\"(rounds={rec['rounds']}, accepted={rec['accepted']})\")\n        except Exception as e:\n            print(f\"  ERROR note {note_id} ({spec}): {e}\")\n    return records\n\n\n# ----------------------------------------------------------------------\n# STATISTICS (item 7)\n# ----------------------------------------------------------------------\ndef bootstrap_qwk(x, y, n_boot=2000, seed=0):\n    rng = np.random.default_rng(seed)\n    vals = []\n    n = len(x)\n    for _ in range(n_boot):\n        idx = rng.integers(0, n, n)\n        sx, sy = x[idx], y[idx]\n        if len(np.unique(sx)) < 2 or len(np.unique(sy)) < 2:\n            continue\n        vals.append(cohen_kappa_score(sx, sy, weights=\"quadratic\"))\n    if not vals:\n        return np.nan, np.nan\n    lo, hi = np.percentile(vals, [2.5, 97.5])\n    return lo, hi\n\n\ndef qwk_report(a, b, min_n):\n    a = pd.to_numeric(pd.Series(np.asarray(a)), errors=\"coerce\")\n    b = pd.to_numeric(pd.Series(np.asarray(b)), errors=\"coerce\")\n    mask = a.notna() & b.notna()\n    x = a[mask].astype(int).to_numpy()\n    y = b[mask].astype(int).to_numpy()\n    n = len(x)\n    out = {\"n\": n, \"dropped\": len(a) - n, \"qwk\": np.nan, \"qwk_lo\": np.nan,\n           \"qwk_hi\": np.nan, \"spearman\": np.nan}\n    if n < 2 or len(np.unique(x)) < 2 or len(np.unique(y)) < 2:\n        out[\"label\"] = \"NOT MEASURABLE (constant or too few scores)\"\n        return out\n    out[\"qwk\"] = cohen_kappa_score(x, y, weights=\"quadratic\")\n    out[\"spearman\"] = spearmanr(x, y)[0]\n    lo, hi = bootstrap_qwk(x, y)\n    out[\"qwk_lo\"], out[\"qwk_hi\"] = lo, hi\n    if n < min_n:\n        out[\"label\"] = f\"INSUFFICIENT N (n={n}, need {min_n})\"\n    elif lo >= QWK_THRESHOLD:\n        out[\"label\"] = \"AGREES\"\n    elif hi >= QWK_THRESHOLD:\n        out[\"label\"] = \"UNCERTAIN\"\n    else:\n        out[\"label\"] = \"DISAGREES\"\n    return out\n\n\ndef agreement_table(results, min_n):\n    rows = []\n    for d in DIMENSIONS:\n        rep = qwk_report(results[f\"claude__{d}\"], results[f\"gemini__{d}\"], min_n)\n        rows.append({\"dimension\": d, **rep})\n    return pd.DataFrame(rows)\n\n\n# ----------------------------------------------------------------------\n# MUTATION TESTING (item 4)\n# ----------------------------------------------------------------------\nMUTANTS = {\n    \"unsupported_claim\": (\"factuality\",\n        lambda s: s + \" The patient was started on warfarin 5 mg daily.\"),\n    \"dropped_diagnosis\": (\"completeness\",\n        lambda s: \" \".join(split_sentences(s)[1:]) or s),\n    \"unsafe_advice\": (\"safety\",\n        lambda s: s + \" The patient may stop all medication without follow-up.\"),\n    \"off_topic\": (\"relevance\",\n        lambda s: \"The weather was pleasant that day. \" + s),\n    \"disorganized\": (\"presentation\",\n        lambda s: \" \".join(s.split()[::-1])),\n}\n\n\ndef run_mutation_tests(records):\n    rows = []\n    for rec in records:\n        note_id, note, summary = rec[\"note_id\"], rec[\"note\"], rec[\"summary\"]\n        base = {\n            \"claude\": {d: rec[f\"claude__{d}\"] for d in DIMENSIONS},\n            \"gemini\": {d: rec[f\"gemini__{d}\"] for d in DIMENSIONS},\n        }\n        for name, (dim, mutate) in MUTANTS.items():\n            mutated = mutate(summary)\n            flagged = not checks_pass(computational_checks(note, mutated))\n            c, _ = judge(\"claude\", f\"{note_id}:{name}\", note, mutated)\n            g, _ = judge(\"gemini\", f\"{note_id}:{name}\", note, mutated)\n            for judge_name, scores in ((\"claude\", c), (\"gemini\", g)):\n                b, m = base[judge_name][dim], scores[dim]\n                rows.append({\n                    \"note_id\": note_id, \"mutant\": name, \"dimension\": dim,\n                    \"judge\": judge_name, \"base\": b, \"mutated\": m,\n                    \"detected\": (b is not None and m is not None and m <= b - 1),\n                    \"computational_flag\": flagged,\n                })\n    return pd.DataFrame(rows)\n\n\ndef mutation_summary(mut):\n    if mut.empty:\n        return mut\n    return mut.groupby([\"mutant\", \"judge\"]).agg(\n        n=(\"detected\", \"size\"),\n        judge_detect_rate=(\"detected\", \"mean\"),\n        computational_flag_rate=(\"computational_flag\", \"mean\"),\n    ).reset_index()\n\n\n# ----------------------------------------------------------------------\n# GOLD SET (item 5)\n# ----------------------------------------------------------------------\ndef export_gold(sample, path):\n    rows = []\n    for _, r in sample.iterrows():\n        rows.append({\n            \"note_id\": r[\"note_id\"], \"specialty\": r[\"medical_specialty\"],\n            \"source_note\": r[\"transcription\"],\n            \"summary\": generate_summary(r[\"transcription\"]),\n            **{f\"rater1__{d}\": \"\" for d in DIMENSIONS},\n            **{f\"rater2__{d}\": \"\" for d in DIMENSIONS},\n            **{f\"consensus__{d}\": \"\" for d in DIMENSIONS},\n        })\n    pd.DataFrame(rows).to_csv(path, index=False)\n    print(f\"Wrote {len(rows)} frozen summaries to {path}\")\n    print(\"Clinicians fill rater1__*, rater2__*, then consensus__* after discussion.\")\n\n\ndef validate_gold(path, out, min_n):\n    g = pd.read_csv(path)\n    rows = []\n    for _, r in g.iterrows():\n        c, _ = judge(\"claude\", r[\"note_id\"], r[\"source_note\"], r[\"summary\"])\n        j, _ = judge(\"gemini\", r[\"note_id\"], r[\"source_note\"], r[\"summary\"])\n        rec = {\"note_id\": r[\"note_id\"]}\n        for d in DIMENSIONS:\n            rec[f\"claude__{d}\"] = c[d]\n            rec[f\"gemini__{d}\"] = j[d]\n            rec[f\"consensus__{d}\"] = r.get(f\"consensus__{d}\")\n        rows.append(rec)\n    J = pd.DataFrame(rows)\n\n    report = []\n    for d in DIMENSIONS:\n        if g[f\"rater1__{d}\"].notna().any() and g[f\"rater2__{d}\"].notna().any():\n            ceiling = qwk_report(g[f\"rater1__{d}\"], g[f\"rater2__{d}\"], min_n)\n            report.append({\"dimension\": d, \"comparison\": \"clinician vs clinician\", **ceiling})\n        for judge_name in (\"claude\", \"gemini\"):\n            rep = qwk_report(J[f\"consensus__{d}\"], J[f\"{judge_name}__{d}\"], min_n)\n            report.append({\"dimension\": d, \"comparison\": f\"{judge_name} vs consensus\", **rep})\n    rep_df = pd.DataFrame(report)\n    rep_df.to_csv(out / \"gold_validation.csv\", 